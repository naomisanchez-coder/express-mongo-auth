<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Dashboard Admin - JWT Auth App</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <style>
        body { background-color: #f4f6f9; }
        .admin-nav { background: linear-gradient(90deg, #b71c1c, #d32f2f); }
        .table-card { border-radius: 12px; padding: 20px; }
    </style>
</head>
<body>

<nav class="admin-nav">
    <div class="nav-wrapper container">
        <a href="#" class="brand-logo"><i class="material-icons">admin_panel_settings</i>Panel Admin</a>
        <ul id="nav-mobile" class="right">
            <li><a href="/profile"><i class="material-icons left">person</i>Mi Perfil</a></li>
            <li><a href="#" id="logoutBtn"><i class="material-icons left">exit_to_app</i>Salir</a></li>
        </ul>
    </div>
</nav>

<div class="container" style="margin-top: 30px;">
    <div class="row">
        <div class="col s12">
            <h4 class="red-text text-darken-4" style="font-weight: 700;">Gestión de Usuarios</h4>
            <p>Lista general de usuarios registrados en el sistema</p>
        </div>
    </div>

    <div class="row">
        <div class="col s12">
            <div class="card table-card z-depth-2">
                <table class="highlight responsive-table">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Roles</th>
                            <th>Fecha Registro</th>
                        </tr>
                    </thead>
                    <tbody id="usersTable">
                        <tr><td colspan="5" class="center-align">Cargando usuarios...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
<script>
    const token = sessionStorage.getItem('jwtToken');
    if (!token) window.location.href = '/signIn';

    async function fetchUsers() {
        try {
            const res = await fetch('/api/users', {
                headers: { 'Authorization': `Bearer ${token}` }
            });

            if (res.status === 403) {
                window.location.href = '/403';
                return;
            }
            if (res.status === 401) {
                sessionStorage.clear();
                window.location.href = '/signIn';
                return;
            }

            const users = await res.json();
            const tbody = document.getElementById('usersTable');
            tbody.innerHTML = '';

            users.forEach(u => {
                const tr = document.createElement('tr');
                const regDate = u.createdAt ? new Date(u.createdAt).toLocaleDateString() : 'N/A';
                const rolesList = u.roles.map(r => r.name || r).join(', ');

                tr.innerHTML = `
                    <td><strong>${u.name || ''} ${u.lastName || ''}</strong></td>
                    <td>${u.email}</td>
                    <td>${u.phoneNumber || 'N/A'}</td>
                    <td><span class="new badge red lighten-1 left" data-badge-caption="">${rolesList}</span></td>
                    <td>${regDate}</td>
                `;
                tbody.appendChild(tr);
            });

        } catch (err) {
            console.error(err);
        }
    }

    document.getElementById('logoutBtn').addEventListener('click', () => {
        sessionStorage.clear();
        window.location.href = '/signIn';
    });

    fetchUsers();
</script>
</body>
</html>